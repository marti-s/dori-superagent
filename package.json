{
  "name": "dori-superagent",
  "version": "0.1.0",
  "description": "A proactive multi-session coding-agent harness in ~1,600 lines, running on herdr + omo.",
  "type": "module",
  "license": "SUL-1.0",
  "packageManager": "bun@1.4.5",
  "bin": {
    "dori": "src/cli.ts"
  },
  "scripts": {
    "check": "biome check .",
    "fmt": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p skills/dori-mode/scripts/tsconfig.json",
    "lint:loc": "bun scripts/check-loc.ts",
    "lint:ratchet": "bun scripts/lint-ratchet.ts",
    "lint:ratchet:update": "bun scripts/lint-ratchet.ts --update",
    "knip": "knip",
    "test": "bun test ./test/ ./scripts/",
    "test:skill": "cd skills/dori-mode/scripts && bun test",
    "ci": "bun run check && bun run typecheck && bun run knip && bun run lint:loc && bun run lint:ratchet && bun run test && bun run test:skill"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "knip": "^6.47.0",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
